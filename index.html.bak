			</p>
			<a href="#" class="btn">Read More</a>
		</div>
	</section>

	<!-- Tour Section Design -->
	<section class="tour">
		<div class="center-text">
			<h2>Popular Tours</h2>
		</div>

		<div class="tour-content">
			<div class="box">
				<img src="img/pic7.jpg">
				<h6>East Java</h6>
				<h4>Mount Bromo</h4>
			</div>

			<div class="box">
				<img src="img/pic8.jpg">
				<h6>East Java</h6>
				<h4>Mount Bromo</h4>
			</div>

			<div class="box">
				<img src="img/pic9.jpg">
				<h6>East Java</h6>
				<h4>Mount Bromo</h4>
			</div>
		</div>

		<div class="center-btn">
			<a href="#" class="btn">See Tours</a>
		</div>
	</section>

	<!-- culture Section Design -->
	<section class="culture">
		<div class="culture-text">
			<h5>INDONESIAN CULTURE</h5>
			<h2>Our culture here is very friendly to people</h2>
			<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
