<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Tavel Website</title>

	<!-- CSS Link -->
	<link rel="stylesheet" type="text/css" href="css/style.css">


	<!-- Boxicons Link -->
	<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

	
	<!-- Remixicon Link -->
	<link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body>

<!-- header design -->
	<header>
		<a href="#" class="logo">Travel <span>WITH ME</span></a>

		<ul class="navbar">
			<li><a href="#">Home</a></li>
			<li><a href="#">Information</a></li>
			<li><a href="#">About Us</a></li>
			<li><a href="#">Culture</a></li>
			<li><a href="#">Contact Us</a></li>
		</ul>

		<div class="h-right">
			<a href="#">Follow Us</a>
			<a href="#"><i class="ri-instagram-fill"></i></a>
			<a href="#"><i class="ri-twitter-fill"></i></a>
			<a href="#"><i class="ri-facebook-fill"></i></a>
			<div class="bx bx-menu" id="menu-icon"></div>
		</div>
	</header>

	<!-- Home Section Design -->
	<section class="home">
		<div class="home-text">
			<h5>LET's</h5>
			<h1>Planning Your <br> Own Travel</h1>
			<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
			tempor incididunt ut labore et dolore magna aliqua. <br>  Ut enim ad minim veniam,
			quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
			consequat.</p>
			<a href="#" class="btn">Boook a Trip</a>
		</div>		
	</section>

	<!-- Feature Section Design -->
	<section class="feature">
		<div class="feature-content">
			<div class="row">
				<div class="row-img">
					<img src="img/pic2.jpg">
				</div>
				<h4>Ski Tours</h4>
			</div>
			<div class="row">
				<div class="row-img">
					<img src="img/pic3.jpg">
				</div>
				<h4>Ski Tours</h4>
			</div>
			<div class="row">
				<div class="row-img">
					<img src="img/pic4.jpg">
				</div>
				<h4>Ski Tours</h4>
			</div>
			<div class="row">
				<div class="row-img">
					<img src="img/pic5.jpg">
				</div>
				<h4>Ski Tours</h4>
			</div>
		</div>
	</section>

	<!-- Holiday Section Design -->
	<section class="holiday">
		<div class="holiday-img">
			<img src="img/pic6.jpg">
		</div>

		<div class="holiday-text">
			<h5>east nusa tengga</h5>
			<h2>Have You Enjoyed your Holidays</h2>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
				tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam,
