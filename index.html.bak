			<img src="img/pic10.jpg">
		</div>
	</section>

	<!-- Newsletter Section -->
	<section class="newlsetter">
		<div class="newsletter-content">
			<div class="newsletter-text">
				<h2> Are You Ready To Explore?</h2>
				<p>Let's go on Vacation, Make Your Day</p>
			</div>

			<form action="#">
				<input type="email" name="" placeholder="Enter Your Name..." required>
				<input type="submit" value="Get Started" class="btn" name="">
			</form>
		</div>
	</section>

	<!-- Footer Section -->
	<section class="footer">
		<div class="footer-box">
			<h3>Services</h3>
			<a href="#">Email Marketing</a>
